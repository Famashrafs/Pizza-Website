# Demo API environment — copy to `server/.env` (git-ignored) and fill in.
# NEVER commit real values. On Render, set these in the service's Environment tab.

# Firebase Admin service account, as a single-line JSON string.
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key, then minify the downloaded JSON onto one line and paste it here
# (enclosed in single quotes). It contains the project_id, client_email and the
# private key — treat the whole value as a secret and never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com","private_key":"<paste the private key value from the JSON>"}'

# Optional: overrides project_id from the service account.
# FIREBASE_PROJECT_ID=resturent-system

# Comma-separated browser origins allowed by CORS (never a wildcard with
# credentials). localhost:3000 is always allowed; add your Vercel URL here.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# "demo" (default) or "live" — surfaced on /api/diagnostics for the migration.
DEMO_MODE=demo

# Render provides PORT automatically; set only for local runs if 8080 is taken.
# PORT=8080
