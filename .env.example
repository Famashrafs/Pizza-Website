# Firebase configuration — copy this file to .env.local and fill in your
# own Firebase project values (see https://console.firebase.google.com).

REACT_APP_FIREBASE_API_KEY=your-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id

# Optional: route order creation + guest lookup through the free-tier demo HTTP
# API (server/, deployed to Render) instead of Firebase Callable Functions.
# Leave unset (or empty) to use the callable transport. Set it to the Render
# service URL, e.g. https://pizza-demo-api.onrender.com
REACT_APP_API_BASE_URL=