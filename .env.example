# Firebase configuration — copy this file to .env.local and fill in your
# own Firebase project values (see https://console.firebase.google.com).

REACT_APP_FIREBASE_API_KEY=your-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id

# Optional: route order creation + guest lookup through the free-tier HTTP
# order API instead of Firebase Callable Functions. The same variable points at
# either transport implementation (both speak the same JSON contract):
#
#   * Cloudflare Worker (worker/wrangler.toml) — template:
#       https://<worker-name>.<your-account>.workers.dev
#   * Express/Render service (server/, render.yaml) — template:
#       https://<your-service>.onrender.com
#
# Paste the URL of an ACTUALLY DEPLOYED service. Leave it empty (or unset) to
# use the callable transport. A non-empty but malformed URL blocks checkout
# with a configuration error — the app never falls back to Firebase silently.
REACT_APP_API_BASE_URL=