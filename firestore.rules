rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // Helpers
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasRole(role) {
      return isSignedIn()
        && 'role' in userDoc()
        && userDoc().role == role;
    }

    function isMemberOf(restaurantId) {
      return isSignedIn()
        && restaurantId != null
        && (
          (
            'restaurantId' in userDoc()
            && userDoc().restaurantId == restaurantId
          )
          ||
          (
            'restaurantIds' in userDoc()
            && userDoc().restaurantIds is map
            && userDoc().restaurantIds.keys().hasAny([restaurantId])
          )
        );
    }

    function canManageRestaurant(restaurantId) {
      return isMemberOf(restaurantId)
        && (
          hasRole('restaurant_owner')
          || hasRole('restaurant_admin')
        );
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // IMPORTANT:
      // Do not inspect resource.data on READ.
      // The document may not exist yet.
      allow read: if isSignedIn()
        && request.auth.uid == userId;

      // Profile creation.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in [
          'customer',
          'restaurant_owner'
        ]
        && isSafeProfileCreate();

      // Profile update.
      allow update: if isSignedIn()
        && isSelfDoc()
        && request.resource.data.role == resource.data.role
        && (
          isRegularProfileUpdate()
          || isOwnershipGrant()
        );

      // User can delete own profile.
      allow delete: if isSignedIn()
        && isSelfDoc();


      function isSelfDoc() {
        return isSignedIn()
          && request.auth.uid == userId
          && resource != null
          && (
            !('uid' in resource.data)
            || resource.data.uid == null
            || resource.data.uid == request.auth.uid
          );
      }


      function isRegularProfileUpdate() {
        return !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'role',
            'restaurantId',
            'restaurantIds'
          ]);
      }


      function isSafeProfileCreate() {
        return (
          !('restaurantId' in request.resource.data)
          || request.resource.data.restaurantId == null
          || request.resource.data.restaurantId == ''
        )
        &&
        (
          !('restaurantIds' in request.resource.data)
          || request.resource.data.restaurantIds == null
          || (
            request.resource.data.restaurantIds is map
            && request.resource.data.restaurantIds.size() == 0
          )
        );
      }


      function isOwnershipGrant() {
        return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'restaurantId',
            'restaurantIds',
            'updatedAt'
          ])

        // The new document MUST contain restaurantId.
        && 'restaurantId' in request.resource.data
        && request.resource.data.restaurantId != null

        // The restaurant must belong to the authenticated owner.
        && get(
          /databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)
        ).data.ownerId == request.auth.uid;
      }
    }


    // =========================================================
    // RESTAURANTS
    // =========================================================

    match /restaurants/{restaurantId} {

      // Authenticated users can read restaurants.
      allow read: if isSignedIn();

      // Owner can create restaurant.
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      // Owner/admin can manage.
      // Unowned restaurants can be claimed.
      allow update: if isSignedIn()
        && (
          isClaim()
          || canManageRestaurant(restaurantId)
        );

      // Platform admin only.
      allow delete: if hasRole('platform_admin');


      function isClaim() {
        return (
          !('ownerId' in resource.data)
          || resource.data.ownerId == null
        )
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'ownerId',
            'ownerTakenAt',
            'updatedAt'
          ]);
      }
    }


    // =========================================================
    // CATEGORIES
    // =========================================================

    match /restaurants/{restaurantId}/categories/{categoryId} {

      allow read: if isSignedIn()
        && isMemberOf(restaurantId);

      allow create, update, delete: if isSignedIn()
        && isMemberOf(restaurantId);
    }


    // =========================================================
    // ORDERS
    // =========================================================

    match /orders/{orderId} {

      // Customer reads own orders.
      // Restaurant members read restaurant orders.
      allow read: if isSignedIn()
        && (
          resource.data.customerId == request.auth.uid
          || isMemberOf(resource.data.restaurantId)
        );

      // Customer creates own order.
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.restaurantId != null
        && request.resource.data.orderStatus == 'placed';

      // Customer cancellation OR restaurant staff update.
      allow update: if isSignedIn()
        && (
          isCustomerCancellation()
          || isStaffOrderUpdate()
        );

      allow delete: if hasRole('platform_admin');


      function isCustomerCancellation() {
        return isSignedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.orderStatus == 'cancelled'
          && resource.data.orderStatus in [
            'placed',
            'confirmed'
          ]
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'orderStatus',
              'cancelledAt',
              'cancelledBy',
              'statusHistory',
              'updatedAt'
            ]);
      }


      function isStaffOrderUpdate() {
        return isSignedIn()
          && isMemberOf(resource.data.restaurantId)

          // Restaurant/customer identity cannot change.
          && request.resource.data.restaurantId
              == resource.data.restaurantId

          && request.resource.data.customerId
              == resource.data.customerId

          // Only status-related fields can change.
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'orderStatus',
              'statusUpdatedAt',
              'statusHistory',
              'cancelledAt',
              'cancelledBy',
              'updatedAt'
            ]);
      }
    }


    // =========================================================
    // PRODUCTS
    // =========================================================

    match /products/{productId} {

      // Public menu.
      allow read: if true;

      // Restaurant members manage products.
      allow create, update, delete: if isSignedIn()
        && isMemberOf(request.resource.data.restaurantId);
    }


    // =========================================================
    // COUPONS
    // =========================================================

    match /coupons/{couponId} {

      allow read: if isSignedIn()
        && isMemberOf(resource.data.restaurantId);

      allow create, update: if isSignedIn()
        && isMemberOf(request.resource.data.restaurantId);
    }


    // =========================================================
    // REVIEWS
    // =========================================================

    match /reviews/{reviewId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid;

      allow update, delete: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid;
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}