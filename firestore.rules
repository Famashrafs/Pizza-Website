rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // Helpers
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // True when the caller is a Firebase ANONYMOUS session (guest checkout).
    // Anonymous users may place and manage their own orders, but they are NOT
    // registered customers: they never get a users/{uid} profile, never hold a
    // role, and never manage any restaurant resource.
    function isAnonymous() {
      return isSignedIn()
        && 'token' in request.auth
        && 'firebase' in request.auth.token
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasRole(role) {
      return isSignedIn()
        && !isAnonymous()
        && 'role' in userDoc()
        && userDoc().role == role;
    }

    function isMemberOf(restaurantId) {
      return isSignedIn()
        && restaurantId != null
        && (
          (
            'restaurantId' in userDoc()
            && userDoc().restaurantId == restaurantId
          )
          ||
          (
            'restaurantIds' in userDoc()
            && userDoc().restaurantIds is map
            && userDoc().restaurantIds.keys().hasAny([restaurantId])
          )
        );
    }

    function canManageRestaurant(restaurantId) {
      // Management requires a REGISTERED account with an owner/admin role.
      // Anonymous (guest) sessions never satisfy isMemberOf (their users doc is
      // denied) and never hold a role, so they are excluded twice over.
      return isMemberOf(restaurantId)
        && (
          hasRole('restaurant_owner')
          || hasRole('restaurant_admin')
        );
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // IMPORTANT:
      // Do not inspect resource.data on READ.
      // The document may not exist yet.
      // Anonymous guests have no profile document; reading it is denied.
      allow read: if isSignedIn()
        && !isAnonymous()
        && request.auth.uid == userId;

      // Profile creation.
      // Registered (non-anonymous) accounts only. Guests never create profiles.
      allow create: if isSignedIn()
        && !isAnonymous()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in [
          'customer',
          'restaurant_owner'
        ]
        && isSafeProfileCreate();

      // Profile update.
      allow update: if isSignedIn()
        && !isAnonymous()
        && isSelfDoc()
        && request.resource.data.role == resource.data.role
        && (
          isRegularProfileUpdate()
          || isOwnershipGrant()
        );

      // User can delete own profile.
      allow delete: if isSignedIn()
        && !isAnonymous()
        && isSelfDoc();


      function isSelfDoc() {
        return isSignedIn()
          && request.auth.uid == userId
          && resource != null
          && (
            !('uid' in resource.data)
            || resource.data.uid == null
            || resource.data.uid == request.auth.uid
          );
      }


      function isRegularProfileUpdate() {
        return !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'role',
            'restaurantId',
            'restaurantIds'
          ]);
      }


      function isSafeProfileCreate() {
        return (
          !('restaurantId' in request.resource.data)
          || request.resource.data.restaurantId == null
          || request.resource.data.restaurantId == ''
        )
        &&
        (
          !('restaurantIds' in request.resource.data)
          || request.resource.data.restaurantIds == null
          || (
            request.resource.data.restaurantIds is map
            && request.resource.data.restaurantIds.size() == 0
          )
        );
      }


      function isOwnershipGrant() {
        return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'restaurantId',
            'restaurantIds',
            'updatedAt'
          ])

        // The new document MUST contain restaurantId.
        && 'restaurantId' in request.resource.data
        && request.resource.data.restaurantId != null

        // The restaurant must belong to the authenticated owner.
        && get(
          /databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)
        ).data.ownerId == request.auth.uid;
      }
    }


    // =========================================================
    // RESTAURANTS
    // =========================================================

    match /restaurants/{restaurantId} {

      // Authenticated users can read restaurants.
      allow read: if isSignedIn();

      // Owner can create restaurant.
      // Anonymous (guest) sessions may not provision restaurants.
      allow create: if isSignedIn()
        && !isAnonymous()
        && request.resource.data.ownerId == request.auth.uid;

      // Owner/admin can manage.
      // Unowned restaurants can be claimed by a REGISTERED account only.
      allow update: if isSignedIn()
        && !isAnonymous()
        && (
          isClaim()
          || canManageRestaurant(restaurantId)
        );

      // Platform admin only.
      allow delete: if hasRole('platform_admin');


      function isClaim() {
        return (
          !('ownerId' in resource.data)
          || resource.data.ownerId == null
        )
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'ownerId',
            'ownerTakenAt',
            'updatedAt'
          ]);
      }
    }


    // =========================================================
    // CATEGORIES
    // =========================================================

    match /restaurants/{restaurantId}/categories/{categoryId} {

      allow read: if isSignedIn()
        && isMemberOf(restaurantId);

      // Writes are scoped to the PATH's restaurant (no transfer is possible)
      // and restricted to registered owner/admin members.
      allow create, update, delete: if isSignedIn()
        && !isAnonymous()
        && canManageRestaurant(restaurantId);
    }


    // =========================================================
    // ORDERS
    // =========================================================

    match /orders/{orderId} {

      // Customer reads own orders.
      // Restaurant members read restaurant orders.
      allow read: if isSignedIn()
        && (
          resource.data.customerId == request.auth.uid
          || isMemberOf(resource.data.restaurantId)
        );

      // ORDER CREATION IS A TRUSTED SERVER PATH ONLY.
      // Direct client writes are DENIED. Orders are created exclusively by the
      // `createOrder` Cloud Function (Firebase Admin SDK), which recomputes
      // every price server-side, enforces the authoritative restaurant
      // settings and dedupes submissions transactionally. The rules never
      // trust a client-supplied total / items / pricing block.
      allow create: if false;

      // Customer cancellation OR restaurant staff update.
      // Staff updates require a registered owner/admin of the order's
      // restaurant; anonymous (guest) sessions may only cancel their own.
      allow update: if isSignedIn()
        && (
          isCustomerCancellation()
          || isStaffOrderUpdate()
        );

      allow delete: if hasRole('platform_admin');


      function isCustomerCancellation() {
        return isSignedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.orderStatus == 'cancelled'
          && resource.data.orderStatus in [
            'placed',
            'confirmed'
          ]
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'orderStatus',
              'cancelledAt',
              'cancelledBy',
              'statusHistory',
              'updatedAt'
            ]);
      }


      function isStaffOrderUpdate() {
        return isSignedIn()
          && !isAnonymous()
          && canManageRestaurant(resource.data.restaurantId)

          // Restaurant/customer identity cannot change.
          && request.resource.data.restaurantId
              == resource.data.restaurantId

          && request.resource.data.customerId
              == resource.data.customerId

          // Only status-related fields can change — never prices, items,
          // payment data or paymentStatus (paymentStatus "paid" cannot be
          // written by staff or customers; only a verified provider would).
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'orderStatus',
              'statusUpdatedAt',
              'statusHistory',
              'cancelledAt',
              'cancelledBy',
              'updatedAt'
            ]);
      }
    }


    // =========================================================
    // PRODUCTS
    // =========================================================

    match /products/{productId} {

      // Public menu.
      allow read: if true;

      // Restaurant owner/admin members manage products.
      allow create: if isSignedIn()
        && !isAnonymous()
        && request.resource.data.restaurantId != null
        && canManageRestaurant(request.resource.data.restaurantId);

      // Update/delete ownership is checked against the EXISTING document so a
      // member of one restaurant can never overwrite or re-home another
      // restaurant's product. restaurantId can never be transferred between
      // restaurants: the incoming document must reuse the stored one.
      allow update: if isSignedIn()
        && !isAnonymous()
        && request.resource.data.restaurantId
            == resource.data.restaurantId
        && canManageRestaurant(resource.data.restaurantId);

      allow delete: if isSignedIn()
        && !isAnonymous()
        && canManageRestaurant(resource.data.restaurantId);
    }


    // =========================================================
    // COUPONS
    // =========================================================

    match /coupons/{couponId} {

      allow read: if isSignedIn()
        && isMemberOf(resource.data.restaurantId);

      allow create: if isSignedIn()
        && !isAnonymous()
        && request.resource.data.restaurantId != null
        && canManageRestaurant(request.resource.data.restaurantId);

      // Same existing-document ownership as products: no transfer, no
      // cross-restaurant overwrite.
      allow update: if isSignedIn()
        && !isAnonymous()
        && request.resource.data.restaurantId
            == resource.data.restaurantId
        && canManageRestaurant(resource.data.restaurantId);
    }


    // =========================================================
    // REVIEWS
    // =========================================================

    match /reviews/{reviewId} {

      allow read: if isSignedIn();

      // Registered customers only, and always against the caller's own uid.
      allow create: if isSignedIn()
        && !isAnonymous()
        && request.resource.data.customerId == request.auth.uid;

      // Update/delete also pin to the ORIGINAL author so a customer can never
      // overwrite or remove another customer's review.
      allow update, delete: if isSignedIn()
        && !isAnonymous()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == request.auth.uid;
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}